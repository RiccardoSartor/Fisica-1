\begin_layout Subsection
Numero di Reynolds
\end_layout

\begin_layout Standard
È una grandezza adimensionale definita come il rapporto delle forze d'inerzia e le forze viscose all'interno di un fluido.
 Determina il passaggio dal regime di moto laminare (ordinato) a quello turbolento (caotico),
 con valori bassi che indicano un flusso laminare e valori alti un flusso turbolento.
\begin_inset Newline newline
\end_inset


\end_layout

\begin_layout Standard
\begin_inset Formula $R_{e}=\frac{\rho*v*L}{\mu}=\frac{v*L}{\nu}$
\end_inset


\begin_inset Newline newline
\end_inset

Dove:
\end_layout

\begin_layout Itemize
\begin_inset Formula $\rho$
\end_inset

:
 Densità del fluido [
\begin_inset Formula $Kg/m^{3}$
\end_inset

]
\end_layout

\begin_layout Itemize
\begin_inset Formula $v$
\end_inset

:
 Velocità del fluido [
\begin_inset Formula $m/s$
\end_inset

]
\end_layout

\begin_layout Itemize
\begin_inset Formula $L$
\end_inset

:
 Lunghezza caratteristica (es.
 diametro del tubo) [
\begin_inset Formula $m$
\end_inset

] 
\end_layout

\begin_layout Itemize
\begin_inset Formula $\mu$
\end_inset

:
 Viscosità dinamica [
\begin_inset Formula $Pa*s=m*s$
\end_inset

]
\end_layout

\begin_layout Itemize
\begin_inset Formula $\nu$
\end_inset

:
 Viscosità cinematica (
\begin_inset Formula $=\frac{\mu}{\rho}$
\end_inset

) [
\begin_inset Formula $m^{2}/s$
\end_inset

]
\end_layout

